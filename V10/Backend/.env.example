# Optional host development only: provision your own local PostgreSQL/OCR.
# Docker Compose at V10 root does not read this file or publish PostgreSQL/OCR.
DATABASE_URL=postgresql://primax:REPLACE_WITH_LOCAL_PASSWORD@localhost:5433/primax_v10?schema=public
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
KIOSK_API_KEY=REPLACE_WITH_RANDOM_TERMINAL_KEY_AT_LEAST_32_CHARACTERS
PORT=3000
SOLES_PER_POINT=9
CORS_ORIGINS=http://localhost:10081,http://127.0.0.1:10081,http://localhost:10082,http://localhost:5180,http://127.0.0.1:5180,http://localhost,https://localhost
DEMO_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
PRIME_DEBT_LIMIT=200
PLATE_CONFIDENCE_THRESHOLD=0.75
PLATE_RECOGNITION_URL=http://localhost:8000
