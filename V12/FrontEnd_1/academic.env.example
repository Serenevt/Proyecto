# Private Vercel Function variables. These are never copied to the static build.
BACKEND_ORIGIN=https://REPLACE_BACKEND_DOMAIN.example.invalid
FUELFLOW_PUBLIC_ORIGIN=https://REPLACE_FUELFLOW_DOMAIN.example.invalid
KIOSK_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_PRIVATE_SECRET_AS_THE_BACKEND
# Vercel supplies VERCEL=1 and enables operator authentication automatically.
# For an explicit local build of the public profile (HTTPS gateway still required):
FUELFLOW_KIOSK_AUTH=true
