{
  "name": "primax-v12-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node dist/src/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-support.cjs",
    "lint": "eslint .",
    "format": "prettier --write src prisma test scripts *.json *.cjs *.md",
    "format:check": "prettier --check src prisma test scripts *.json *.cjs *.md",
    "test": "jest --runInBand --config jest.config.cjs",
    "test:e2e": "node scripts/local-db-command.cjs jest --runInBand --config test/jest-e2e.config.cjs",
    "demo": "node scripts/demo.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/local-db-command.cjs prisma migrate deploy",
    "prisma:migrate:dev": "node scripts/local-db-command.cjs prisma migrate dev",
    "prisma:seed": "node scripts/local-db-command.cjs seed prisma/seed.ts",
    "prisma:studio": "node scripts/local-db-command.cjs prisma studio",
    "test:safety": "node --test scripts/database-safety.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "nodemailer": "10.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
