POSTGRES_DB=primax_v10
POSTGRES_USER=primax
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
PORT=10000
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# KIOSK_API_KEY from existing installations is supported if KIOSK_SECRET is absent.
KIOSK_SECRET=REPLACE_WITH_RANDOM_TERMINAL_KEY_AT_LEAST_32_CHARACTERS
SOLES_PER_POINT=9
CORS_ORIGINS=http://localhost:10081,http://127.0.0.1:10081,http://localhost:10082,http://127.0.0.1:10082,http://localhost:5180,http://127.0.0.1:5180,http://localhost,https://localhost
DEMO_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
# Local tooling only; Compose constructs its own URL using postgres:5432.
# DATABASE_URL=postgresql://primax:URL_ENCODED_LOCAL_PASSWORD@localhost:5433/primax_v10?schema=public

PRIME_DEBT_LIMIT=200
PLATE_CONFIDENCE_THRESHOLD=0.75
PLATE_RECOGNITION_URL=http://plate-recognition:8000
FRONTEND1_PORT=10081
FRONTEND2_PORT=10082
# LAN overrides only; local PORT remains unchanged.
LAN_BACKEND_PORT=10000
LAN_BACKEND_BIND=0.0.0.0
# Android build shell only: PRIME_API_BASE_URL=http://IP_DEL_HOST:10000/api/v1
# Future shared server: PRIME_API_BASE_URL=https://api.example.com/api/v1

# Local mail is captured in Mailpit; no delivery to Gmail/Outlook.
APP_MODE=local
SHOW_DEMO_ADMIN_CREDENTIALS=true
DEMO_ADMIN_USER=admin-demo
DEMO_ADMIN_PASSWORD=LocalAdminV10!
# Separate production admin; never returned by the demo-credentials endpoint.
ADMIN_USER=
ADMIN_PASSWORD_HASH=
PASSWORD_RESET_DELIVERY=mailpit
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
MAILPIT_PORT=10025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Primax Prime <no-reply@primax.local>
# For external email: PASSWORD_RESET_DELIVERY=smtp, provider host/port/from,
# SMTP_USER and SMTP_PASSWORD from your provider. TLS is mandatory externally.
# For production: APP_MODE=production, SHOW_DEMO_ADMIN_CREDENTIALS=false.
# Optional DBeaver loopback override only:
POSTGRES_LOCAL_PORT=10543
