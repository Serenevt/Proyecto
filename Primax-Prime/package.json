{
  "name": "primax-prime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.cjs",
    "build": "node tools/build.cjs",
    "test": "node --test tests/*.test.js",
    "test:mobile": "node tools/mobile.cjs",
