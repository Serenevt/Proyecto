# Copy to .env for the isolated V12.1 local Compose stack. Replace every
# REPLACE value with a locally generated random value; never commit .env.
POSTGRES_DB=primax_v12_1_local
POSTGRES_USER=primax_v12_1
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_BYTES
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_BYTES
JWT_SECRET=REPLACE_WITH_RANDOM_HEX_32_BYTES
KIOSK_API_KEY=REPLACE_WITH_RANDOM_HEX_32_BYTES

# Local demo accounts. Set unique local-only passwords (12+ characters).
DEMO_PASSWORD=REPLACE_WITH_LOCAL_PRIME_DEMO_PASSWORD
DEMO_CONTROL_ADMIN_ENABLED=true
DEMO_CONTROL_ADMIN_EMAIL=control-admin@primax.local
DEMO_CONTROL_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
DEMO_OPERATIONS_ENABLED=true
DEMO_SUPERVISOR_EMAIL=supervisor@primax.local
DEMO_SUPERVISOR_PASSWORD=REPLACE_WITH_LOCAL_SUPERVISOR_PASSWORD

# Optional loopback-only ports. PostgreSQL and Redis are not published by default.
FRONTEND1_PORT=26081
FRONTEND2_PORT=26082
FRONTEND3_PORT=26083
BACKEND_PORT=26000
MAILPIT_PORT=26025
PRIMAX_CONTROL_PUBLIC_URL=http://localhost:26083
