# Local compose has isolated development defaults. Never use them in production.
APP_MODE=local
PAYMENT_ENV=demo
DEMO_WALLET_ENABLED=true
CULQI_SECRET_KEY=REPLACE_WITH_TEST_SECRET
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_CHARACTER_SECRET
BACKEND_UPSTREAM=http://backend:3000
# Android/public web build: same public backend as BACKEND_UPSTREAM.
PRIME_API_BASE_URL=https://REPLACE_WITH_BACKEND_DOMAIN/api/v1
# Managed PostgreSQL (configure directly in backend hosting environment).
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?sslmode=require
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHARACTER_SECRET
KIOSK_API_KEY=REPLACE_WITH_RANDOM_32_CHARACTER_SECRET
# Email delivery remains disabled until a real SMTP provider is configured.
PASSWORD_RESET_DELIVERY=disabled
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_FROM=REPLACE_VERIFIED_SENDER
CORS_ORIGINS=https://REPLACE_PRIME_DOMAIN,https://REPLACE_FUELFLOW_DOMAIN,https://localhost,capacitor://localhost
PLATE_RECOGNITION_URL=https://REPLACE_PROTECTED_OCR_DOMAIN
SHOW_DEMO_ADMIN_CREDENTIALS=false
ADMIN_USER=REPLACE_ADMIN_USER
ADMIN_PASSWORD_HASH=REPLACE_BCRYPT_HASH
SOLES_PER_POINT=9

# Local npm CLI wrappers reuse DATABASE_URL when DATABASE_URL_UNPOOLED is absent.
# Set a matching direct local connection only when necessary. Remote CLI targets are blocked.
PLATE_RECOGNITION_ENABLED=true
