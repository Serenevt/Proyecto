# TEMPLATE ONLY. Configure private variables in the backend Vercel project.
# No dotenv file is committed with real values. Do not copy the local demo profile.
APP_MODE=academic
DATABASE_PURPOSE=academic-demo
PAYMENT_ENV=demo
DEMO_WALLET_ENABLED=true
# CULQI_SECRET_KEY must be absent.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_ENDPOINT-pooler.example.invalid/academic_demo?sslmode=require&connection_limit=2&connect_timeout=15&pool_timeout=15
DATABASE_URL_UNPOOLED=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_ENDPOINT.example.invalid/academic_demo?sslmode=require
JWT_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET_32_OR_MORE_CHARACTERS
KIOSK_API_KEY=REPLACE_WITH_PRIVATE_RANDOM_TERMINAL_KEY_32_OR_MORE_CHARACTERS
KIOSK_GATEWAY_SECRET=REPLACE_WITH_PRIVATE_SHARED_GATEWAY_SECRET_32_OR_MORE_CHARACTERS
KIOSK_OPERATOR_USER=REPLACE_OPERATOR_USERNAME
KIOSK_OPERATOR_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH_COST_12
KIOSK_STATION_ID=REPLACE_WITH_EXISTING_DEMO_STATION_UUID
KIOSK_SESSION_NAMESPACE=primax-v12-academic
KIOSK_SESSION_VERSION=1
KIOSK_REDIS_REST_URL=https://REPLACE_REDIS_ENDPOINT.example.invalid
KIOSK_REDIS_REST_TOKEN=REPLACE_WITH_PRIVATE_REDIS_REST_TOKEN
CORS_ORIGINS=https://REPLACE_PRIME_DOMAIN.example.invalid,https://REPLACE_FUELFLOW_DOMAIN.example.invalid
SHOW_DEMO_ADMIN_CREDENTIALS=false
PASSWORD_RESET_DELIVERY=disabled
PLATE_RECOGNITION_ENABLED=false
SOLES_PER_POINT=9
PRIME_DEBT_LIMIT=200
SWAGGER_ENABLED=false
